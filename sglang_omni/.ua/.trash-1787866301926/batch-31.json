{
  "nodes": [
    {
      "id": "file:utils/ipc_weights.py",
      "type": "file",
      "name": "ipc_weights.py",
      "filePath": "utils/ipc_weights.py",
      "summary": "实现同一 GPU 上数据并行副本间的 CUDA IPC 权重共享协议：领导副本原子发布句柄，从副本零拷贝别名共享张量、按值保留私有状态，并校验目录权限、模型身份、清单和领导进程存活性。",
      "tags": [
        "cuda-ipc",
        "weight-sharing",
        "data-parallel",
        "model-weights",
        "security"
      ],
      "complexity": "complex"
    },
    {
      "id": "class:utils/ipc_weights.py:WeightShareConfig",
      "type": "class",
      "name": "WeightShareConfig",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        77,
        81
      ],
      "summary": "保存权重共享角色、私有存储目录、从副本附加超时和可选运行标识，是领导与从属流程的统一环境配置。",
      "tags": [
        "weight-sharing",
        "configuration",
        "leader-follower",
        "timeout"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:utils/ipc_weights.py:WeightSharePolicy",
      "type": "class",
      "name": "WeightSharePolicy",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        241,
        250
      ],
      "summary": "声明经架构审计后必须保持副本私有的参数或缓冲区名称，其余注册张量默认通过 CUDA IPC 共享。",
      "tags": [
        "weight-sharing",
        "architecture-policy",
        "private-tensors",
        "safety"
      ],
      "complexity": "simple"
    },
    {
      "id": "function:utils/ipc_weights.py:get_weight_share_config",
      "type": "function",
      "name": "get_weight_share_config",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        84,
        114
      ],
      "summary": "解析权重共享环境变量中的 leader 或 follower 角色、目录、超时与 run_id，并对格式和数值范围进行严格校验。",
      "tags": [
        "environment",
        "weight-sharing",
        "configuration",
        "validation"
      ],
      "complexity": "moderate"
    },
    {
      "id": "function:utils/ipc_weights.py:validate_weight_share_architecture",
      "type": "function",
      "name": "validate_weight_share_architecture",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        325,
        350
      ],
      "summary": "要求模型配置恰好包含一个已完成审计和端到端验证的架构，并返回其私有张量策略；未支持架构以失败关闭方式拒绝。",
      "tags": [
        "architecture",
        "weight-sharing",
        "policy-validation",
        "fail-closed"
      ],
      "complexity": "moderate"
    },
    {
      "id": "class:utils/ipc_weights.py:LeaderLivenessMonitor",
      "type": "class",
      "name": "LeaderLivenessMonitor",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        439,
        493
      ],
      "summary": "在从副本后台轮询领导进程及其 Linux 启动时间，识别死亡或 PID 回收后立即退出，避免继续访问已失效的 CUDA IPC 映射。",
      "tags": [
        "leader-liveness",
        "cuda-ipc",
        "process-monitor",
        "fail-fast"
      ],
      "complexity": "moderate"
    },
    {
      "id": "function:utils/ipc_weights.py:export_weights",
      "type": "function",
      "name": "export_weights",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        547,
        627
      ],
      "summary": "收集模型参数和缓冲区，按策略拆分 IPC 共享与按值传输张量，写入版本化身份及清单元数据，并以临时文件和原子重命名发布句柄载荷。",
      "tags": [
        "cuda-ipc",
        "weight-export",
        "atomic-write",
        "tensor-manifest",
        "security"
      ],
      "complexity": "complex"
    },
    {
      "id": "function:utils/ipc_weights.py:wait_for_export",
      "type": "function",
      "name": "wait_for_export",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        630,
        643
      ],
      "summary": "轮询等待领导副本的引擎专属句柄文件完成原子发布，并在截止时间后给出指向领导启动状态的超时错误。",
      "tags": [
        "weight-sharing",
        "polling",
        "timeout",
        "leader-follower"
      ],
      "complexity": "simple"
    },
    {
      "id": "function:utils/ipc_weights.py:attach_weights",
      "type": "function",
      "name": "attach_weights",
      "filePath": "utils/ipc_weights.py",
      "lineRange": [
        772,
        805
      ],
      "summary": "等待并加载领导载荷，将从副本的共享参数和缓冲区别名到领导存储，同时把私有或非 CUDA 张量复制到自身存储，并返回后续验证记录。",
      "tags": [
        "cuda-ipc",
        "weight-attach",
        "zero-copy",
        "private-tensors",
        "validation"
      ],
      "complexity": "complex"
    },
    {
